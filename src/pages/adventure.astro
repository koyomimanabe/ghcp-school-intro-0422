---
import BaseLayout from '../layouts/BaseLayout.astro';
import HiddenEmoji from '../components/HiddenEmoji.astro';
---
<BaseLayout title="冒険モード | 神山まるごと高専 冒険サイト">
  <section class="max-w-6xl mx-auto px-4 py-10">
    <p class="font-pop text-xl text-deco-pink text-center">🎮 ADVENTURE MODE</p>
    <h1 class="font-pop text-5xl md:text-7xl text-center mt-2 neon text-rainbow">神山 採集の旅</h1>
    <p class="text-center mt-4 font-bold">30秒で「神山の象徴」を集めろ！<br>⬅ ➡ or A/D キー／画面タップでプレイヤー移動</p>

    <div class="mt-6 flex flex-wrap gap-3 justify-center items-center">
      <button id="start-btn" class="btn-pop bg-deco-pink text-white text-xl">▶️ スタート</button>
      <div id="hud" class="font-pop text-xl bg-white border-pop shadow-pop px-4 py-2 rounded-full">⏱ <span id="time">30</span>s / 🎒 <span id="score">0</span> / 🏆 Best: <span id="best">0</span></div>
    </div>

    <div
      id="stage"
      tabindex="0"
      role="application"
      aria-label="神山採集ミニゲーム"
      class="mt-6 relative w-full overflow-hidden border-pop rounded-3xl bg-gradient-to-b from-deco-electric/40 to-deco-mint/60 shadow-pop"
      style="height: 360px;"
    >
      <!-- Background hills -->
      <svg class="absolute bottom-0 w-full" viewBox="0 0 1600 200" preserveAspectRatio="none" style="height:70%">
        <polygon points="0,200 200,60 450,140 700,40 950,130 1200,50 1450,120 1600,80 1600,200" fill="#c9a7ff"/>
        <polygon points="0,200 150,120 400,170 650,110 900,160 1150,100 1400,150 1600,130 1600,200" fill="#6bf2c6"/>
      </svg>
      <div class="absolute top-4 left-4 text-4xl animate-spin-slow">☀️</div>
      <div id="player" class="absolute text-4xl bottom-4 left-1/2 -translate-x-1/2 transition-transform" style="will-change: transform;">🧑‍🎓</div>

      <div id="overlay" class="absolute inset-0 flex flex-col items-center justify-center bg-black/40 text-white text-center p-4">
        <p class="font-pop text-3xl neon">スタートを押して冒険！</p>
        <p class="mt-2 text-sm">※ キーボード（← → / A D）またはタップで移動</p>
      </div>

      <!-- Touch controls -->
      <div class="absolute bottom-2 left-0 right-0 flex justify-between px-4 md:hidden">
        <button class="touch-btn btn-pop bg-white text-2xl" data-dir="-1" aria-label="左へ">◀</button>
        <button class="touch-btn btn-pop bg-white text-2xl" data-dir="1" aria-label="右へ">▶</button>
      </div>
    </div>

    <p id="result" class="mt-6 text-center font-pop text-2xl"></p>

    <section class="mt-10 grid md:grid-cols-3 gap-4">
      <div class="comic-frame p-4 bg-white"><b>🍃 葉っぱ</b>…+1 / 自然の気配</div>
      <div class="comic-frame p-4 bg-white"><b>💡 LED</b>…+2 / ひらめき</div>
      <div class="comic-frame p-4 bg-white"><b>🍊 スダチ</b>…+2 / 徳島の香り</div>
      <div class="comic-frame p-4 bg-white"><b>📜 コード</b>…+3 / テックの証</div>
      <div class="comic-frame p-4 bg-white"><b>🎨 アート</b>…+3 / デザインの種</div>
      <div class="comic-frame p-4 bg-white"><b>⚡ 起業スパーク</b>…+5 / レア！</div>
    </section>

    <div class="mt-10 text-right">
      <HiddenEmoji id="adventure" emoji="🌸" hint="冒険ページに隠れた絵文字！" />
    </div>
  </section>

  <script>
    import { getBestScore, setBestScore } from '../lib/storage.ts';
    import { pickupSe, sparkleSe } from '../lib/audio.ts';

    const stage = document.getElementById('stage') as HTMLDivElement;
    const player = document.getElementById('player') as HTMLDivElement;
    const overlay = document.getElementById('overlay') as HTMLDivElement;
    const startBtn = document.getElementById('start-btn') as HTMLButtonElement;
    const timeEl = document.getElementById('time') as HTMLElement;
    const scoreEl = document.getElementById('score') as HTMLElement;
    const bestEl = document.getElementById('best') as HTMLElement;
    const resultEl = document.getElementById('result') as HTMLElement;

    const ITEMS: { emoji: string; score: number }[] = [
      { emoji: '🍃', score: 1 },
      { emoji: '💡', score: 2 },
      { emoji: '🍊', score: 2 },
      { emoji: '📜', score: 3 },
      { emoji: '🎨', score: 3 },
      { emoji: '⚡', score: 5 },
    ];

    let running = false;
    let score = 0;
    let timeLeft = 30;
    let pxRatio = 0;
    let playerX = 0;
    const SPEED = 6;
    const keys: Record<string, boolean> = {};
    let spawnTimer: number | null = null;
    let tickTimer: number | null = null;
    let rafId = 0;

    bestEl.textContent = String(getBestScore());

    function positionPlayer() {
      const w = stage.clientWidth;
      playerX = Math.max(20, Math.min(w - 40, playerX));
      player.style.left = `${playerX}px`;
      player.style.transform = `translateX(-50%)`;
    }

    function spawn() {
      if (!running) return;
      const w = stage.clientWidth;
      const item = ITEMS[Math.floor(Math.random() * ITEMS.length)];
      const el = document.createElement('div');
      el.textContent = item.emoji;
      el.className = 'absolute text-3xl select-none';
      el.dataset.score = String(item.score);
      el.style.left = `${20 + Math.random() * (w - 40)}px`;
      el.style.top = `-40px`;
      el.style.filter = 'drop-shadow(2px 2px 0 #0c0a1a)';
      stage.appendChild(el);
      const fall = 1500 + Math.random() * 2000;
      const startT = performance.now();
      const h = stage.clientHeight;
      const targetY = h - 40;
      function step(now: number) {
        if (!running) { el.remove(); return; }
        const t = (now - startT) / fall;
        const y = t * targetY;
        el.style.top = `${y}px`;
        const left = parseFloat(el.style.left);
        // collision
        if (Math.abs(left - playerX) < 36 && y > targetY - 60) {
          score += parseInt(el.dataset.score || '0', 10);
          scoreEl.textContent = String(score);
          pickupSe();
          el.remove();
          return;
        }
        if (t >= 1) { el.remove(); return; }
        requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    function loop() {
      if (!running) return;
      let dx = 0;
      if (keys['ArrowLeft'] || keys['a']) dx -= SPEED;
      if (keys['ArrowRight'] || keys['d']) dx += SPEED;
      if (dx) {
        playerX += dx;
        positionPlayer();
      }
      rafId = requestAnimationFrame(loop);
    }

    function start() {
      if (running) return;
      running = true;
      score = 0;
      timeLeft = 30;
      scoreEl.textContent = '0';
      timeEl.textContent = '30';
      resultEl.textContent = '';
      overlay.style.display = 'none';
      playerX = stage.clientWidth / 2;
      positionPlayer();
      stage.focus();
      spawnTimer = window.setInterval(spawn, 600);
      tickTimer = window.setInterval(() => {
        timeLeft--;
        timeEl.textContent = String(timeLeft);
        if (timeLeft <= 0) end();
      }, 1000);
      rafId = requestAnimationFrame(loop);
    }

    function end() {
      running = false;
      if (spawnTimer) clearInterval(spawnTimer);
      if (tickTimer) clearInterval(tickTimer);
      cancelAnimationFrame(rafId);
      stage.querySelectorAll('div:not(#player):not(#overlay)').forEach((el) => el.remove());
      const best = setBestScore(score);
      bestEl.textContent = String(best);
      let title = '🌱 見習い冒険者';
      if (score >= 50) title = '👑 神山マスター';
      else if (score >= 30) title = '⚡ 起業スパーカー';
      else if (score >= 15) title = '🎨 デザインキッド';
      else if (score >= 8) title = '💻 コードっ子';
      resultEl.innerHTML = `結果: <span class="text-rainbow">${score}</span> pt / 称号: <b>${title}</b>`;
      sparkleSe();
      overlay.style.display = 'flex';
      (overlay.querySelector('p') as HTMLElement).textContent = 'もう一度スタートで再挑戦！';
    }

    startBtn.addEventListener('click', start);
    stage.addEventListener('keydown', (e) => { keys[e.key] = true; });
    stage.addEventListener('keyup', (e) => { keys[e.key] = false; });
    window.addEventListener('keydown', (e) => {
      if (!running) return;
      if (['ArrowLeft','ArrowRight','a','d'].includes(e.key)) { keys[e.key] = true; e.preventDefault(); }
    });
    window.addEventListener('keyup', (e) => { keys[e.key] = false; });
    document.querySelectorAll<HTMLButtonElement>('.touch-btn').forEach((b) => {
      const dir = parseInt(b.dataset.dir || '0', 10);
      const press = () => { keys[dir < 0 ? 'ArrowLeft' : 'ArrowRight'] = true; };
      const release = () => { keys[dir < 0 ? 'ArrowLeft' : 'ArrowRight'] = false; };
      b.addEventListener('pointerdown', press);
      b.addEventListener('pointerup', release);
      b.addEventListener('pointerleave', release);
    });

    stage.addEventListener('pointerdown', (e) => {
      if (!running) return;
      const rect = stage.getBoundingClientRect();
      const px = e.clientX - rect.left;
      playerX = px;
      positionPlayer();
    });

    window.addEventListener('resize', positionPlayer);
    positionPlayer();
  </script>
</BaseLayout>
