---
import '../styles/global.css';
import CustomCursor from './CustomCursor.astro';

interface Props {
  title?: string;
}

const { title = '神山まるごと高専 — KAMIYAMA KOSEN' } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="神山まるごと高専 - テクノロジー×デザイン×アントレプレナーシップの新しい高専" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700;900&family=DotGothic16&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- カスタムカーソル -->
    <CustomCursor />

    <!-- パーティクルコンテナ（クリック時ハート） -->
    <div id="particles-container"></div>

    <!-- コナミコード発動時のオーバーレイ -->
    <div id="konami-overlay" class="fixed inset-0 z-50 flex items-center justify-center pointer-events-none opacity-0" style="background: rgba(0,0,0,0.9);">
      <div class="text-center">
        <div class="text-6xl mb-4" style="font-family: 'DotGothic16'">🌈 まるごとモード 🌈</div>
        <div class="text-2xl" style="color: #FF69B4">発動しためぽ！！</div>
      </div>
    </div>

    <!-- メインコンテンツ -->
    <slot />

    <!-- GSAP -->
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { TextPlugin } from 'gsap/TextPlugin';
      import { MotionPathPlugin } from 'gsap/MotionPathPlugin';

      gsap.registerPlugin(ScrollTrigger, TextPlugin, MotionPathPlugin);

      // グローバルに公開
      (window as any).gsap = gsap;
      (window as any).ScrollTrigger = ScrollTrigger;
    </script>
  </body>
</html>
