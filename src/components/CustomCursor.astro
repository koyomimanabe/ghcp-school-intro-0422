---
// カスタムカーソルコンポーネント
---

<div id="cursor" class="fixed pointer-events-none z-[99999] transition-transform duration-100" style="top: 0; left: 0;">
  <div id="cursor-star" style="
    width: 20px;
    height: 20px;
    font-size: 18px;
    transform: translate(-50%, -50%);
    user-select: none;
  ">⭐</div>
</div>

<div id="cursor-trail" class="fixed pointer-events-none z-[99998]" style="top: 0; left: 0;">
</div>

<script>
  const cursor = document.getElementById('cursor')!;
  const trailContainer = document.getElementById('cursor-trail')!;
  const trailStars = ['✨', '💫', '⭐', '🌟'];
  let mouseX = 0;
  let mouseY = 0;
  let trails: HTMLElement[] = [];

  document.addEventListener('mousemove', (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
    cursor.style.transform = `translate(${mouseX}px, ${mouseY}px)`;
    createTrail(mouseX, mouseY);
  });

  function createTrail(x: number, y: number) {
    const trail = document.createElement('div');
    trail.style.cssText = `
      position: fixed;
      left: ${x}px;
      top: ${y}px;
      font-size: 12px;
      transform: translate(-50%, -50%);
      pointer-events: none;
      z-index: 99998;
      opacity: 0.8;
      transition: all 0.5s ease;
    `;
    trail.textContent = trailStars[Math.floor(Math.random() * trailStars.length)];
    trailContainer.appendChild(trail);

    requestAnimationFrame(() => {
      trail.style.opacity = '0';
      trail.style.transform = `translate(-50%, -80%) scale(0.3)`;
    });

    setTimeout(() => {
      trail.remove();
    }, 500);
  }

  // クリック時にハートが散るパーティクルエフェクト
  document.addEventListener('click', (e) => {
    createHeartParticles(e.clientX, e.clientY);
  });

  function createHeartParticles(x: number, y: number) {
    const hearts = ['❤️', '💖', '💗', '💓', '💞', '💕', '🩷'];
    const container = document.getElementById('particles-container')!;

    for (let i = 0; i < 8; i++) {
      const particle = document.createElement('div');
      const angle = (Math.PI * 2 / 8) * i;
      const distance = 60 + Math.random() * 40;
      const targetX = x + Math.cos(angle) * distance;
      const targetY = y + Math.sin(angle) * distance;

      particle.style.cssText = `
        position: fixed;
        left: ${x}px;
        top: ${y}px;
        font-size: ${14 + Math.random() * 10}px;
        pointer-events: none;
        z-index: 99999;
        transform: translate(-50%, -50%);
        transition: none;
      `;
      particle.textContent = hearts[Math.floor(Math.random() * hearts.length)];
      container.appendChild(particle);

      requestAnimationFrame(() => {
        particle.style.transition = 'all 0.6s ease-out';
        particle.style.left = `${targetX}px`;
        particle.style.top = `${targetY}px`;
        particle.style.opacity = '0';
        particle.style.fontSize = '8px';
      });

      setTimeout(() => particle.remove(), 600);
    }
  }
</script>
